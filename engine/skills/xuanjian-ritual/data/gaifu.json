      "代价": "时间成本",
      "态度": "主力建议",
      "条目": [
        {
          "名": "择时：把大事放到用神运",
          "做法": "结婚、开业、跳槽、买房，尽量排到用神当令或忌神受制的大运流年；排不开就缩小规模",
          "依据": "xuanjian-kb 42／44／71 §2",
          "周期": "按十年一步运规划",
          "花费": "无",
          "风险级": "甲",
          "不可承诺": "不承诺'选对年份就成'"
        },
        {
          "名": "避运：忌神年不加杠杆",
          "做法": "忌神当令年不扩张、不举债、不换赛道，把损耗压到最低",
          "依据": "xuanjian-kb 44",
          "周期": "一年",
          "花费": "无",
          "风险级": "甲",
          "不可承诺": "不承诺'躲过就没事'"
        },
        {
          "名": "借运：借环境与他人的势",
          "做法": "换城市、换行业、换圈子，借外部五行与资源补原局之缺（如木弱去东方、入林农文教）",
          "依据": "xuanjian-kb 50／19",
          "周期": "一至三年",
          "花费": "中至高",
          "风险级": "甲",
          "不可承诺": "不承诺'换个地方就翻身'"
        },
        {
          "名": "交脱运年的缓冲",
          "做法": "两步大运交接前后一年，不做重大决定；已定的推迟三个月执行",
          "依据": "xuanjian-kb 37",
          "周期": "一年",
          "花费": "无",
          "风险级": "甲",
          "不可承诺": "不承诺'不动就平安'"
        }
      ]
    },
    {
      "层": "三",
      "名": "人事",
      "能改": "换人、换做法、换信息源",
      "见效": "随时",
      "代价": "关系成本",
      "态度": "最快最实，优先给",
      "条目": [
        {
          "名": "换对接人",
          "做法": "卡你的是人还是事？若是人，找能拍板的那个，不跟执行层继续磨",
          "依据": "xuanjian-kb 28 §2",
          "周期": "一周内",
          "花费": "无",
          "风险级": "甲",
          "不可承诺": "不承诺'换个领导就好了'"
        },
        {
          "名": "改说法：只说事实与条件",
          "做法": "谈判与争取时只讲事实、条件、期限；不讲情绪与旧账",
          "依据": "xuanjian-kb 28 §3",
          "周期": "随时",
          "花费": "无",
          "风险级": "甲",
          "不可承诺": "不承诺'会说话就能办成'"
