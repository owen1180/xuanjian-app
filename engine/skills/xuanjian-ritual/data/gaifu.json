{
  "版本": "1.0",
  "生成日期": "2026-11-02",
  "说明": "六层改运体系。层越靠下见效越快，层越靠上越改不动。排序铁律：先给人事与地理，再谈科仪。",
  "总则": [
    "不承诺效果：任何一条都只能说'把该做的做了'，不能说'做了就会好'。",
    "不替代医疗：涉及身体，先过就医触发清单。",
    "不针对第三人：一切以操控他人为目的的条目，归丙档，只解释不做。",
    "收费透明：本馆不代收、不抽成、不指定合作方分成。"
  ],
  "层级": [
    {
      "层": "一",
      "名": "命",
      "能改": "改不了，只能认清",
      "见效": "—",
      "代价": "—",
      "态度": "先讲清，不许骗客户'能改'",
      "条目": [
        {
          "名": "认清格局与用神",
          "做法": "按四柱打分定旺衰、取用神、定层次，把'这一生哪块有力、哪块费劲'讲清楚",
          "依据": "xuanjian-kb 01／02／39",
          "周期": "一次讲清",
          "花费": "无",
          "风险级": "甲",
          "不可承诺": "不承诺'知道了就能改'"
        },
        {
          "名": "接受不可改的部分",
          "做法": "把'出身、父母、身高、早年际遇'单列，明确告知这几项不在可改范围",
          "依据": "本馆归纳",
          "周期": "一次",
          "花费": "无",
          "风险级": "甲",
          "不可承诺": "不承诺'放下就好了'"
        },
        {
          "名": "分清'命苦'与'运滞'",
          "做法": "原局弱是底色，运滞是阶段。多数人把阶段当底色，才会绝望",
          "依据": "xuanjian-kb 43",
          "周期": "一次",
          "花费": "无",
          "风险级": "甲",
          "不可承诺": "不承诺'熬过去一定好'"
        }
      ]
    },
    {
      "层": "二",
      "名": "运",
      "能改": "择时、借运、避运",
